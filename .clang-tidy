---
Checks: >-
  -*,
  clang-analyzer-*,
  clang-diagnostic-*,
  bugprone-*,
  cert-*,
  concurrency-*,
  cppcoreguidelines-*,
  hicpp-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-unchecked-optional-access,
  -cppcoreguidelines-avoid-magic-numbers,
  -hicpp-use-auto,
  -modernize-use-trailing-return-type,
  -misc-include-cleaner,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-redundant-member-init,
  -readability-redundant-declaration,
  -clang-analyzer-optin.core.EnumCastOutOfRange

# clang-analyzer-optin.core.EnumCastOutOfRange is disabled because InputCapability is a bitmask
# enum. Its `operator|` and `operator&` cast a combined integer back to the enum by design, and the
# checker has no model for flag enums, so every combination it sees looks like an invented value.

# readability-redundant-declaration is disabled because -fno-exceptions (see CMakeLists.txt) makes
# libc++ declare operator new/delete twice with differing exception specifications. The diagnostic
# lands in a system header but is reported against every translation unit, and neither
# SystemHeaders: false nor HeaderFilterRegex can exclude it.

WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(source|examples|tests)/'
ExcludeHeaderFilterRegex: '(^|/)(build[^/]*/|external/|third_party/|vendor/)'
SystemHeaders: false

FormatStyle: file
HeaderFileExtensions: ['', h, hh, hpp, hxx]
ImplementationFileExtensions: [c, cc, cpp, cppm, cxx]

CheckOptions:
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.InlineNamespaceCase: lower_case
  readability-identifier-naming.IgnoreMainLikeFunctions: true
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.AbstractClassCase: CamelCase
  readability-identifier-naming.AbstractClassPrefix: 'I'
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.ScopedEnumConstantCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: camelBack
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.PublicMethodCase: CamelCase
  readability-identifier-naming.PrivateMethodCase: camelBack
  readability-identifier-naming.PrivateMethodPrefix: '_'
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.PublicMemberCase: CamelCase
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberPrefix: '_'
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberPrefix: '_'

  bugprone-argument-comment.CommentBoolLiterals: true
  bugprone-assert-side-effect.AssertMacros: 'assert;DBG_ASSERT'
  bugprone-exception-escape.FunctionsThatShouldNotThrow: 'main;.*::swap;swap'
  cppcoreguidelines-avoid-do-while.IgnoreMacros: true
  cppcoreguidelines-explicit-virtual-functions.IgnoreDestructors: true
  cppcoreguidelines-narrowing-conversions.WarnOnEquivalentBitWidth: true
  cppcoreguidelines-pro-type-member-init.IgnoreArrays: false
  cppcoreguidelines-pro-type-member-init.UseAssignment: false
  cppcoreguidelines-use-default-member-init.IgnoreMacros: true
  cppcoreguidelines-use-default-member-init.UseAssignment: false
  cppcoreguidelines-rvalue-reference-param-not-moved.AllowPartialMove: false
  cppcoreguidelines-rvalue-reference-param-not-moved.IgnoreUnnamedParams: false
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  hicpp-special-member-functions.AllowSoleDefaultDtor: true
  modernize-use-default-member-init.UseAssignment: false
  modernize-use-designated-initializers.IgnoreMacros: true
  modernize-use-designated-initializers.IgnoreSingleElementAggregates: false
  modernize-use-designated-initializers.RestrictToPODTypes: false
  modernize-use-designated-initializers.StrictCppStandardCompliance: true
  modernize-use-nodiscard.ReplacementString: '[[nodiscard]]'
  performance-move-const-arg.CheckTriviallyCopyableMove: true
  hicpp-named-parameter.InsertPlainNamesInForwardDecls: true
  readability-inconsistent-declaration-parameter-name.Strict: true
  readability-named-parameter.InsertPlainNamesInForwardDecls: true
  readability-function-cognitive-complexity.Threshold: 25
  readability-function-size.LineThreshold: 120
  readability-function-size.StatementThreshold: 80
  readability-implicit-bool-conversion.AllowIntegerConditions: false
  readability-implicit-bool-conversion.AllowPointerConditions: false
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
...
